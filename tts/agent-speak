#!/usr/bin/env python3
"""agent-speak — harness-agnostic local TTS.

Reads text from stdin (or argv), strips markdown, and speaks it with Kokoro
(local, via the `kokoro-tts` CLI). On PipeWire/PulseAudio it ducks other
applications' audio while speaking and restores it afterward. Only one
utterance plays at a time: a new invocation interrupts the previous one.

This script knows nothing about any agent harness. Each harness gets a thin
adapter that pipes the assistant's text into here. See the companion docs.

Config via environment:
  AGENT_SPEAK_VOICE       voice name or blend (default: af_heart)
  AGENT_SPEAK_SPEED       speech speed float (default: 1.1)
  AGENT_SPEAK_LANG        language (default: en-us)
  AGENT_SPEAK_DUCK        1/0 enable audio ducking (default: 1)
  AGENT_SPEAK_DUCK_LEVEL  fraction other apps drop to, 0..1 (default: 0.25)
  AGENT_SPEAK_MAXCHARS    truncate spoken text (default: 1200)
  AGENT_SPEAK_DISABLE     1 to make this a no-op (kill switch)
  KOKORO_HOME             dir holding kokoro-v1.0.onnx + voices-v1.0.bin
                          (default: ~/.local/share/kokoro)
"""
import os
import re
import sys
import signal
import shutil
import subprocess
from pathlib import Path

HOME = Path.home()
KOKORO_HOME = Path(os.environ.get("KOKORO_HOME", HOME / ".local/share/kokoro"))
MODEL = KOKORO_HOME / "kokoro-v1.0.onnx"
VOICES = KOKORO_HOME / "voices-v1.0.bin"

VOICE = os.environ.get("AGENT_SPEAK_VOICE", "af_heart")
SPEED = os.environ.get("AGENT_SPEAK_SPEED", "1.1")
LANG = os.environ.get("AGENT_SPEAK_LANG", "en-us")
DUCK = os.environ.get("AGENT_SPEAK_DUCK", "1") != "0"
DUCK_LEVEL = float(os.environ.get("AGENT_SPEAK_DUCK_LEVEL", "0.25"))
MAXCHARS = int(os.environ.get("AGENT_SPEAK_MAXCHARS", "1200"))

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "agent-speak"
PIDFILE = RUNTIME / "current.pid"

# Persistent mute flag, toggleable mid-session via the `tts` command.
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
MUTEFILE = Path(os.environ.get("AGENT_SPEAK_MUTEFILE", STATE_HOME / "agent-speak/muted"))


# ---------------------------------------------------------------- text cleanup
def clean_markdown(text: str) -> str:
    """Turn markdown-ish assistant text into something pleasant to hear."""
    # Drop fenced code blocks entirely; reading code aloud is noise.
    text = re.sub(r"```.*?```", " (code block) ", text, flags=re.DOTALL)
    text = re.sub(r"~~~.*?~~~", " (code block) ", text, flags=re.DOTALL)
    # Inline code -> just the contents.
    text = re.sub(r"`([^`]*)`", r"\1", text)
    # Images / links -> keep the visible text.
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", " ", text)
    text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)
    # Headings, blockquotes, list bullets, emphasis, table pipes.
    text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text, flags=re.MULTILINE)
    text = re.sub(r"^\s*>+\s?", "", text, flags=re.MULTILINE)
    text = re.sub(r"^\s*[-*+]\s+", "", text, flags=re.MULTILINE)
    text = re.sub(r"^\s*\d+\.\s+", "", text, flags=re.MULTILINE)
    text = re.sub(r"[*_]{1,3}([^*_]+)[*_]{1,3}", r"\1", text)
    # Drop markdown table separator rows (|---|:--:|) before stripping pipes.
    text = re.sub(r"^\s*\|?[\s:|-]*-[\s:|-]*\|?\s*$", "", text, flags=re.MULTILINE)
    text = text.replace("|", " ")
    # Strip bare URLs.
    text = re.sub(r"https?://\S+", " a link ", text)
    # Collapse whitespace.
    text = re.sub(r"\s+", " ", text).strip()
    return text


# --------------------------------------------------------------- tool lookup
def find_kokoro():
    """Locate the kokoro-tts CLI without depending on the caller's PATH.

    Hook subprocesses (e.g. Claude Code's Stop hook) often run with a minimal
    PATH that lacks ~/.local/bin, so PATH-only lookup silently fails. Check the
    known uv-tool install locations explicitly.
    """
    hit = shutil.which("kokoro-tts")
    if hit:
        return hit
    for cand in (
        HOME / ".local/bin/kokoro-tts",
        HOME / ".local/share/uv/tools/kokoro-tts/bin/kokoro-tts",
    ):
        if cand.exists():
            return str(cand)
    return None


# -------------------------------------------------------------------- ducking
def _pactl():
    return shutil.which("pactl") or (
        "/usr/bin/pactl" if Path("/usr/bin/pactl").exists() else None
    )


def snapshot_and_duck():
    """Lower every other playback stream to DUCK_LEVEL of its current volume.

    Returns a list of (index, original_volume_percent) to restore later.
    Snapshot is taken before the TTS stream exists, so TTS is never ducked.
    """
    saved = []
    pactl = _pactl()
    if not (DUCK and pactl):
        return saved
    try:
        out = subprocess.run(
            [pactl, "list", "sink-inputs"],
            capture_output=True, text=True, timeout=4,
        ).stdout
    except Exception:
        return saved
    index = None
    for line in out.splitlines():
        m = re.match(r"Sink Input #(\d+)", line)
        if m:
            index = m.group(1)
            continue
        m = re.search(r"Volume:.*?/\s*(\d+)%", line)
        if m and index is not None:
            pct = int(m.group(1))
            saved.append((index, pct))
            target = max(0, int(pct * DUCK_LEVEL))
            try:
                subprocess.run(
                    [pactl, "set-sink-input-volume", index, f"{target}%"],
                    timeout=4,
                )
            except Exception:
                pass
            index = None
    return saved


def restore(saved):
    pactl = _pactl()
    if not pactl:
        return
    for index, pct in saved:
        try:
            subprocess.run(
                [pactl, "set-sink-input-volume", index, f"{pct}%"], timeout=4
            )
        except Exception:
            pass


# ----------------------------------------------------------- single-instance
def kill_previous():
    try:
        old = int(PIDFILE.read_text().strip())
    except Exception:
        return
    if old == os.getpid():
        return
    try:
        os.killpg(old, signal.SIGTERM)
    except ProcessLookupError:
        return
    except Exception:
        return
    # Wait briefly for it to clean up (restore volumes) and exit.
    for _ in range(50):
        try:
            os.killpg(old, 0)
        except ProcessLookupError:
            return
        except Exception:
            return
        import time
        time.sleep(0.02)


def main():
    if os.environ.get("AGENT_SPEAK_DISABLE") == "1":
        return 0
    if MUTEFILE.exists():  # toggled at runtime via `tts off`
        return 0
    if not (MODEL.exists() and VOICES.exists()):
        sys.stderr.write(f"agent-speak: model files missing in {KOKORO_HOME}\n")
        return 0  # never break a hook
    kokoro = find_kokoro()
    if not kokoro:
        sys.stderr.write("agent-speak: kokoro-tts not found\n")
        return 0

    text = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
    text = clean_markdown(text)[:MAXCHARS]
    if not text:
        return 0

    RUNTIME.mkdir(parents=True, exist_ok=True)
    # Own a fresh process group so a future invocation can kill our whole tree.
    os.setpgrp()
    kill_previous()
    PIDFILE.write_text(str(os.getpid()))

    saved = []
    child = None

    def cleanup(*_):
        if child and child.poll() is None:
            try:
                child.terminate()
            except Exception:
                pass
        restore(saved)
        try:
            if PIDFILE.read_text().strip() == str(os.getpid()):
                PIDFILE.unlink()
        except Exception:
            pass

    signal.signal(signal.SIGTERM, lambda *_: (cleanup(), os._exit(0)))
    signal.signal(signal.SIGINT, lambda *_: (cleanup(), os._exit(0)))

    try:
        saved = snapshot_and_duck()
        child = subprocess.Popen(
            [kokoro, "-", "--stream",
             "--voice", VOICE, "--speed", SPEED, "--lang", LANG,
             "--model", str(MODEL), "--voices", str(VOICES)],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        child.communicate(text.encode("utf-8", "ignore"))
    finally:
        cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main())
